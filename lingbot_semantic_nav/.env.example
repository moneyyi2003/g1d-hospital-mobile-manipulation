# First choice for this scaffold. Do not commit the real key.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional future provider. This adapter uses the OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini

# Formal runs should fail closed. Enable only for offline demos/tests.
LLM_ALLOW_RULE_FALLBACK=false
